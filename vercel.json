{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/verify",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|auth/|verify|assets/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
